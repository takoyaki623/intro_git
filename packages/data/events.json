            "kind": "message",
            "text": "じゃあ さっそく しょうぶだ!",
            "speaker": "グリーン"
          },
          {
            "kind": "if",
            "cond": {
              "kind": "hasSpecies",
              "species": "bulbasaur"
            },
            "then": [
              {
                "kind": "battle",
                "trainer": "kanto-rival-charmander",
                "onWin": "kanto.pallet.rival-win",
                "onLose": "kanto.pallet.rival-lose"
              }
            ],
            "else": [
              {
                "kind": "if",
                "cond": {
                  "kind": "hasSpecies",
                  "species": "charmander"
                },
                "then": [
                  {
                    "kind": "battle",
                    "trainer": "kanto-rival-squirtle",
                    "onWin": "kanto.pallet.rival-win",
                    "onLose": "kanto.pallet.rival-lose"
                  }
                ],
                "else": [
                  {
                    "kind": "battle",
                    "trainer": "kanto-rival-bulbasaur",
                    "onWin": "kanto.pallet.rival-win",
                    "onLose": "kanto.pallet.rival-lose"
                  }
                ]
              }
            ]
          }
        ],
        "else": [
          {
            "kind": "message",
            "text": "おまえも ポケモンを もらいに きたのか?",
            "speaker": "グリーン"
          }
