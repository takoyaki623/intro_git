{
  "name": "pokemon-rpg",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "個人利用のポケモン風RPG。設計は docs/ を参照。",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "soak": "vitest run soak",
    "dev": "vite packages/game",
    "build": "vite build packages/game",
    "gen:ids": "vite-node tools/gen-ids.ts",
    "import": "vite-node tools/import.ts",
    "validate": "vite-node tools/validate.ts",
    "scaffold": "vite-node tools/scaffold.ts",
    "data": "npm run import && npm run gen:ids && npm run validate",
    "check": "npm run validate && npm run typecheck && npm run test && vite-node tools/gen-ids.ts --check"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "playwright": "^1.62.1",
    "typescript": "^5.6.3",
    "vite": "^8.2.1",
    "vite-node": "^6.0.0",
    "vitest": "^2.1.4"
  }
}
