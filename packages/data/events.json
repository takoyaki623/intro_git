  {
    "id": "kanto.pallet.rival",
    "commands": [
      {
        "kind": "if",
        "cond": {
          "kind": "flag",
          "flag": "kanto.pallet.got-starter",
          "value": true
        },
        "then": [
          {
            "kind": "message",
            "text": "まてよ! おれにも 1ぴき くれよ。",
            "speaker": "グリーン"
